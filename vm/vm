#!/bin/bash
# Drive the development VM created by vm/create.sh.
# GNOME=<major> selects the VM (default 50), see vm/common.sh.
set -euo pipefail

source "$(dirname "$0")/common.sh"
VIRSH=(virsh -q -c $CONN)
SSH=(ssh -i "$STATE/id_ed25519" -p "$SSH_PORT" -o StrictHostKeyChecking=no
     -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5
     dev@127.0.0.1)
# Commands run over ssh need the logged-in session's bus
BUS='export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus;'

usage() {
    cat <<USAGE
usage: [GNOME=<major>] vm/vm <command> [args]
  start | stop | status      power the VM on/off (start waits for the shell)
  ssh [cmd...]               shell or command as user dev
  restart-shell              restart GDM (auto-login) to load new extension code
  wait-shell                 block until GNOME Shell is up, then leave the overview
  eval <js>                  run JS in the VM's gnome-shell, print the result
  prefs                      (re)open the extension's settings window
  logs [journalctl args]     gnome-shell log of the current boot
  screenshot [file.png]      capture the VM display (default .vm/screen-<major>.png)
  key <KEY>...               press a key combo, e.g. key KEY_LEFTMETA KEY_SLASH
  type <text>                type ASCII text (US layout)
  click <x> <y>              left-click at absolute screen coordinates
  snapshot <name>            snapshot the (shut off) VM
  revert <name>              revert to a snapshot
USAGE
}

shell_eval() {
    "${SSH[@]}" "$BUS"' code=$(cat); gdbus call --session --dest org.gnome.Shell \
        --object-path /org/gnome/Shell --method org.gnome.Shell.Eval "$code"' <<<"$1"
}

wait_shell() {
    for _ in $(seq 90); do
        if shell_eval 'Main.layoutManager._startingUp === false' 2>/dev/null |
            grep -q "(true, 'true')"; then
            # GNOME starts in the overview; begin tests from the desktop
            sleep 1
            shell_eval 'Main.overview.hide()' >/dev/null
            sleep 1
            return 0
        fi
        sleep 2
    done
    echo "GNOME Shell did not come up" >&2
    return 1
}

# QMP absolute pointer coordinates are 0..32767 over the whole display
qmp_click() {
    local res w h x y
    res=$(shell_eval 'const [w, h] = global.stage.get_size(); `${w}x${h}`' |
        grep -oE '[0-9]+x[0-9]+' | tr x ' ')
    read -r w h <<<"$res"
    x=$(( $1 * 32767 / w )); y=$(( $2 * 32767 / h ))
    "${VIRSH[@]}" qemu-monitor-command $VM "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[
        {\"type\":\"abs\",\"data\":{\"axis\":\"x\",\"value\":$x}},
        {\"type\":\"abs\",\"data\":{\"axis\":\"y\",\"value\":$y}}]}}" >/dev/null
    for down in true false; do
        "${VIRSH[@]}" qemu-monitor-command $VM "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[
            {\"type\":\"btn\",\"data\":{\"down\":$down,\"button\":\"left\"}}]}}" >/dev/null
    done
}

type_text() {
    local text=$1 i c
    for ((i = 0; i < ${#text}; i++)); do
        c=${text:i:1}
        case $c in
        [a-z]) "${VIRSH[@]}" send-key $VM "KEY_${c^^}" ;;
        [A-Z]) "${VIRSH[@]}" send-key $VM KEY_LEFTSHIFT "KEY_$c" ;;
        [0-9]) "${VIRSH[@]}" send-key $VM "KEY_$c" ;;
        ' ') "${VIRSH[@]}" send-key $VM KEY_SPACE ;;
        '-') "${VIRSH[@]}" send-key $VM KEY_MINUS ;;
        '.') "${VIRSH[@]}" send-key $VM KEY_DOT ;;
        '/') "${VIRSH[@]}" send-key $VM KEY_SLASH ;;
        '~') "${VIRSH[@]}" send-key $VM KEY_LEFTSHIFT KEY_GRAVE ;;
        '_') "${VIRSH[@]}" send-key $VM KEY_LEFTSHIFT KEY_MINUS ;;
        *) echo "type: unsupported character '$c'" >&2; return 1 ;;
        esac >/dev/null
    done
}

cmd=${1:-help}
shift || true
case $cmd in
start)
    "${VIRSH[@]}" start $VM
    wait_shell ;;
stop) "${VIRSH[@]}" shutdown $VM ;;
status) "${VIRSH[@]}" domstate $VM ;;
ssh) "${SSH[@]}" "$@" ;;
restart-shell)
    "${SSH[@]}" sudo systemctl restart gdm
    sleep 3
    wait_shell ;;
wait-shell) wait_shell ;;
eval) shell_eval "$1" ;;
prefs)
    # The Extensions app is a D-Bus service: a fresh start right after a
    # kill sometimes drops the first request, so retry until it shows
    name=$(grep -oP '"name":\s*"\K[^"]+' "$REPO/metadata.json")
    uuid=$(grep -oP '"uuid":\s*"\K[^"]+' "$REPO/metadata.json")
    "${SSH[@]}" pkill -f org.gnome.Shell.Extensions || true
    for _ in 1 2 3 4 5; do
        "${SSH[@]}" "$BUS gnome-extensions prefs $uuid"
        sleep 2
        shell_eval "global.display.focus_window?.title === '$name'" |
            grep -q "'true'" && exit 0
    done
    echo "settings window did not open" >&2
    exit 1 ;;
logs) "${SSH[@]}" journalctl -b -o cat /usr/bin/gnome-shell "$@" ;;
screenshot)
    out=${1:-$STATE/screen-$GNOME.png}
    "${VIRSH[@]}" screenshot $VM "$out.tmp" >/dev/null
    magick "$out.tmp" "$out" && rm "$out.tmp"
    echo "$out" ;;
key) "${VIRSH[@]}" send-key $VM "$@" >/dev/null ;;
type) type_text "$1" ;;
click) qmp_click "$1" "$2" ;;
snapshot) "${VIRSH[@]}" snapshot-create-as $VM "$1" ;;
revert) "${VIRSH[@]}" snapshot-revert $VM "$1" ;;
*) usage ;;
esac
